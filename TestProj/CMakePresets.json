{
    "version": 3,

    "configurePresets": [
        {
            "name": "Windows-debug",
            "displayName": "Windows debug build",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_STANDARD": "17",
                "CMAKE_CUDA_STANDARD": "17",
                "CMAKE_CUDA_ARCHITECTURES": "native",
                "CMAKE_CUDA_SEPERABLE_COMPILATION": "ON"
            },
            "environment": {
                "PATH": "C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v13.4/bin;$penv{PATH}"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "build-debug",
            "configurePreset": "Windows-debug"
        }
    ]
}